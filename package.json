{
  "name": "@keshavsoft/json-to-tag",
  "version": "1.9.3",
  "description": "Zero-dependency declarative JSON-to-DOM compiler. Transform JSON specifications into native browser DOM elements via a multi-stage assembly pipeline with built-in tag catalog validation.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "json-to-tag": "bin/cli.js"
  },
  "files": [
    "bin",
    "index.js",
    "src",
    "docs/tags",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/json-to-tag.git"
  },
  "keywords": [
    "json-to-dom",
    "declarative-ui",
    "dom-builder",
    "json-specification",
    "zero-dependency",
    "tag-catalog",
    "spec-to-dom"
  ],
  "author": "KeshavSoft",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/keshavsoft/json-to-tag/issues"
  },
  "homepage": "https://keshavsoft.github.io/json-to-tag/",
  "devDependencies": {
    "vite": "^8.2.1",
    "jsdom": "^29.1.1"
  },
  "dependencies": {}
}