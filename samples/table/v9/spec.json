{
    "tagName": "table",
    "attributes": {
        "class": "table table-hover table-striped align-middle border mb-0"
    },
    "children": [
        {
            "tagName": "thead",
            "attributes": {
                "class": "table-dark",
                "data-role": "table-header"
            },
            "children": [
                {
                    "tagName": "tr",
                    "attributes": {
                        "data-role": "table-header-row"
                    },
                    "children": [
                        {
                            "tagName": "th",
                            "textContent": "columnName",
                            "attributes": {
                                "class": "py-3 px-3 fw-semibold text-uppercase small"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}